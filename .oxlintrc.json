{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "vitest", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-underscore-dangle": ["warn", { "allow": ["__damDebug"] }],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }],

    // Phaser's types declare `export = Phaser`, so these two misfire on `import Phaser from 'phaser'`.
    "import/default": "off",
    "import/no-named-as-default-member": "off",

    // Menus are non-modal popovers closed by useDismiss; a native <dialog> would change their behavior.
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "test-results", "playwright-report"]
}
